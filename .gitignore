# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
.venv-win/
venv/
env/

# Caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.mypy_cache/

# Local environment / secrets
.env
.env.local

# Generated artifacts
data/*
!data/.gitkeep
sec_dividend_analysis.csv
artifacts/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Local agent tooling (installed per-machine, not shared)
.agents/
.claude/

# Accidental command-output junk (PowerShell redirect artifact)
t -ErrorAction SilentlyContinue | Select-Object Name,Source

# Session scratch files (throwaway probes, runners, captured output)
/_*.py
/_*.sh
/_*.out

# OpenBB provider credentials (loaded at runtime by src/crispdm/openbb_client.py)
ObbCredentials.json
artifacts/*
!artifacts/.gitkeep
