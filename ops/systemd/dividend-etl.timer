[Unit]
Description=Nightly trigger for dividend-etl.service

[Timer]
# 03:00 Eastern Time (DST-aware). systemd resolves this IANA zone against the
# system tzdata; Persistent=true catches up a missed run after reboot/idle.
OnCalendar=*-*-* 03:00:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target