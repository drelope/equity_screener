DATABASE_URL=postgresql+psycopg://dividend:dividend@localhost:5432/dividend
SEC_USER_AGENT=Your Name your.email@example.com
OPENBB_PROVIDER=
MIN_RECALL=0.30
# Read by docker-compose.yml. POSTGRES_PASSWORD defaults to "dividend" (loopback-only);
# API_KEY is REQUIRED by every `docker compose` command (not just `api`): export it in the
# shell first (README, "Start PostgreSQL with Docker Compose"). Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
API_KEY=
# Web app operator controls (queue/schedule/cancel tasks, call the API). Leave empty for
# a read-only app. At least 12 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
OPS_ADMIN_TOKEN=
# Where the web app's Integrations page finds the API (the API key is API_KEY, see README).
API_BASE_URL=http://localhost:8000
# Flag a security as a dividend payer only from a positive per-share dividend
# fact (or an observed payment) inside DIVIDEND_RECENCY_DAYS (548). Aggregate
# payables and dividends-received concepts never flag. Set false to restore any-fact-ever.
ENFORCE_DIVIDEND_RECENCY=true
